# Flask
FLASK_APP=run.py
FLASK_ENV=production
SECRET_KEY=change-me-in-production

# Database. SQLite is used by default for zero-setup local runs; docker-compose
# points this at Postgres instead (Postgres is the preferred DB per the spec).
# NOTE: a relative sqlite:/// URI is resolved by Flask relative to its
# instance/ folder automatically - keep this as a bare filename (no
# "instance/" prefix) or it resolves to instance/instance/app.db and fails.
DATABASE_URL=sqlite:///app.db

# Scraping behaviour
HTTP_TIMEOUT_SECONDS=12
HTTP_MAX_RETRIES=3
RATE_LIMIT_SECONDS_PER_DOMAIN=1.5
SEARCH_CACHE_TTL_SECONDS=900
SCRAPE_MAX_WORKERS=3

# EMI defaults (used when the user does not choose a tenure/rate)
EMI_DEFAULT_TENURE_MONTHS=12
EMI_DEFAULT_ANNUAL_RATE_PERCENT=14.0

# Logging. Leave LOG_FILE unset (or blank) to log to the terminal instead -
# that's what Docker/Render use (see render.yaml), since Render's log
# viewer reads container stdout and a file inside that container would
# vanish on redeploy. Set here for local dev so a `/api/search` run (one
# log line per HTTP fetch, across 3 adapters) doesn't clutter the terminal.
LOG_LEVEL=INFO
LOG_FILE=process.log
